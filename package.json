{
  "name": "pcore-orchestra",
  "version": "3.9.0",
  "description": "Multi-agent orchestra for Cursor, OpenCode CLI, Qoder CLI, Claude Code, and Codex CLI",
  "main": "bundle/hooks/orchestra-prompt.js",
  "scripts": {
    "test": "node scripts/test-adaptive-loop.js",
    "test:capabilities": "node scripts/test-agent-capabilities.js",
    "test:e2e": "node scripts/test-e2e-suite.js",
    "test:all": "node scripts/test-e2e-suite.js",
    "agents:enrich": "node scripts/enrich-agent-capabilities.js",
    "agents:sync": "node scripts/sync-qoder-agents.js && node scripts/sync-claude-agents.js && node scripts/sync-codex-agents.js && node scripts/gen-agent-registry.js"
  },
  "keywords": [
    "orchestra",
    "cursor",
    "opencode",
    "qoder",
    "claude-code",
    "codex",
    "agents",
    "mcp"
  ],
  "author": "P-Core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-Core-System/pcore-orchestra.git"
  },
  "homepage": "https://github.com/P-Core-System/pcore-orchestra#readme",
  "bugs": {
    "url": "https://github.com/P-Core-System/pcore-orchestra/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
