<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.pcore.orchestra-studio</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>node</string>
        <string>@REPO_ROOT@/server/studio-api.js</string>
        <string>--port</string>
        <string>@PORT@</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@REPO_ROOT@</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/studio.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/studio.log</string>
</dict>
</plist>
