{
  "type": "workspace_readwrite",
  "enableSharedBuildCache": true,
  "additionalReadwritePaths": [
    "$HOME/.cursor/hooks",
    "$HOME/.cursor/skills",
    "$HOME/.agents/skills",
    "$HOME/.config/opencode"
  ],
  "additionalReadonlyPaths": [
    "$HOME/.cursor/rules"
  ],
  "networkPolicy": {
    "default": "allow",
    "deny": [
      "169.254.169.254",
      "metadata.google.internal"
    ]
  }
}
