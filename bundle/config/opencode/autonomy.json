{
  "model": "opencode/mimo-v2.5-free",
  "small_model": "opencode/mimo-v2.5-free",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 6000,
    "tail_turns": 12
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 12288
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", "build/**", "coverage/**"]
  },
  "default_agent": "orchestra",
  "snapshot": false,
  "instructions": [
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "**/context/project-overview.md",
    "**/context/architecture.md",
    "**/context/code-standards.md",
    "**/context/progress-tracker.md"
  ],
  "permission": {
    "*": "allow",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/credentials.json": "deny"
    },
    "bash": {
      "*": "allow",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "rm -rf / *": "deny",
      "rm -rf ~ *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.cursor/hooks/**": "allow",
      "~/.cursor/skills/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/Learning Web Development/**": "allow",
      "~/Projects/**": "allow",
      "~/Developer/**": "allow",
      "~/code/**": "allow"
    },
    "skill": {
      "*": "deny",
      "orchestra-loop": "allow",
      "verification-before-completion": "allow",
      "prompt-intake": "allow",
      "greenfield-product": "allow",
      "internal-*": "deny"
    },
    "websearch": "allow",
    "webfetch": "allow",
    "task": "allow"
  },
  "agent": {
    "orchestra": {
      "description": "Orchestra conductor — plan → implement → verify → review via task tool",
      "mode": "primary",
      "model": "opencode/mimo-v2.5-free",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 24,
      "permission": {
        "task": {
          "*": "deny",
          "orchestra-*": "allow"
        },
        "bash": "allow",
        "edit": "deny",
        "websearch": "allow",
        "webfetch": "allow",
        "skill": {
          "*": "deny",
          "orchestra-loop": "allow",
          "prompt-intake": "allow"
        }
      }
    },
    "orchestra-planner": {
      "description": "Internal orchestra phase 1 — plan only",
      "mode": "subagent",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
      "steps": 8,
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "orchestra-loop": "allow",
          "prompt-intake": "allow"
        }
      }
    },
    "orchestra-implementer": {
      "description": "Internal orchestra phase 2 — implement",
      "mode": "subagent",
      "reasoningEffort": "medium",
      "textVerbosity": "medium",
      "steps": 20,
      "hidden": true,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "websearch": "deny",
        "webfetch": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "orchestra-loop": "allow",
          "verification-before-completion": "allow"
        }
      }
    },
    "orchestra-verifier": {
      "description": "Internal orchestra phase 3 — verify",
      "mode": "subagent",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 8,
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "deny",
        "webfetch": "deny",
        "task": "deny",
        "skill": {
          "*": "deny",
          "orchestra-loop": "allow",
          "verification-before-completion": "allow"
        }
      }
    },
    "orchestra-reviewer": {
      "description": "Internal orchestra phase 4 — review",
      "mode": "subagent",
      "reasoningEffort": "medium",
      "textVerbosity": "low",
      "steps": 5,
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "task": "deny",
        "skill": {
          "*": "deny",
          "orchestra-loop": "allow",
          "verification-before-completion": "allow"
        }
      }
    }
  },
  "provider": {
    "opencode": {
      "models": {
        "mimo-v2.5-free": {
          "variants": {
            "fast": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            },
            "thorough": {
              "reasoningEffort": "high"
            }
          }
        },
        "mimo-v2.5-free (ox-alpha)": {
          "variants": {
            "fast": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            },
            "quality": {
              "reasoningEffort": "medium",
              "textVerbosity": "medium"
            }
          }
        },
      }
    }
  }
}
