{
  "version": 2,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./hooks/orchestra-session-start.js"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./hooks/orchestra-prompt.js",
        "matcher": "UserPromptSubmit",
        "timeout": 5
      }
    ],
    "subagentStop": [
      {
        "command": "node ./hooks/orchestra-subagent-stop.js",
        "matcher": "business-analyst|product-manager|architect|tech-lead|project-manager|backend-engineer|frontend-engineer|full-stack-engineer|database-engineer|qa-engineer|automation-engineer|security-engineer|accessibility-reviewer|documentation-writer|release-manager|devops-engineer|sre|observer|code-reviewer|performance-engineer|platform-engineer|cloud-engineer|infrastructure-engineer|orchestra-planner|orchestra-implementer|orchestra-verifier|orchestra-reviewer",
        "loop_limit": 12
      },
      {
        "command": "node ./hooks/orchestra-lifecycle.js",
        "matcher": "business-analyst|product-manager|architect|tech-lead|project-manager|backend-engineer|frontend-engineer|full-stack-engineer|database-engineer|qa-engineer|automation-engineer|security-engineer|accessibility-reviewer|documentation-writer|release-manager|devops-engineer|sre|observer|code-reviewer|performance-engineer|platform-engineer|cloud-engineer|infrastructure-engineer|orchestra-planner|orchestra-implementer|orchestra-verifier|orchestra-reviewer",
        "loop_limit": 12
      },
      {
        "command": "node ./hooks/orchestra-memory.js",
        "matcher": "orchestra-planner|orchestra-implementer|orchestra-verifier|orchestra-reviewer",
        "loop_limit": 12
      },
      {
        "command": "node ./hooks/orchestra-quality-gate.js",
        "matcher": "orchestra-reviewer|code-reviewer|release-manager",
        "loop_limit": 5
      }
    ],
    "stop": [
      {
        "command": "node ./hooks/orchestra-stop.js",
        "loop_limit": 5
      },
      {
        "command": "node ./hooks/orchestra-heartbeat.js",
        "loop_limit": 5
      }
    ]
  }
}
