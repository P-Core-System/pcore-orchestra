{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./hooks/orchestra-session-start.js"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./hooks/orchestra-prompt.js",
        "matcher": "UserPromptSubmit",
        "timeout": 5
      }
    ],
    "subagentStop": [
      {
        "command": "node ./hooks/orchestra-subagent-stop.js",
        "matcher": "accessibility-reviewer|architect|automation-engineer|backend-engineer|business-analyst|cloud-engineer|code-reviewer|database-engineer|devops-engineer|documentation-writer|frontend-engineer|full-stack-engineer|infrastructure-engineer|observer|orchestra-implementer|orchestra-planner|orchestra-reviewer|orchestra-verifier|performance-engineer|platform-engineer|product-manager|project-manager|qa-engineer|release-manager|security-engineer|sre|tech-lead",
        "loop_limit": 12
      },
      {
        "command": "node ./hooks/orchestra-lifecycle.js",
        "matcher": "accessibility-reviewer|architect|automation-engineer|backend-engineer|business-analyst|cloud-engineer|code-reviewer|database-engineer|devops-engineer|documentation-writer|frontend-engineer|full-stack-engineer|infrastructure-engineer|observer|orchestra-implementer|orchestra-planner|orchestra-reviewer|orchestra-verifier|performance-engineer|platform-engineer|product-manager|project-manager|qa-engineer|release-manager|security-engineer|sre|tech-lead",
        "loop_limit": 12
      },
      {
        "command": "node ./hooks/orchestra-memory.js",
        "matcher": "orchestra-planner|orchestra-implementer|orchestra-verifier|orchestra-reviewer",
        "loop_limit": 12
      },
      {
        "command": "node ./hooks/orchestra-quality-gate.js",
        "matcher": "orchestra-reviewer|code-reviewer|release-manager",
        "loop_limit": 5
      }
    ],
    "stop": [
      {
        "command": "node ./hooks/orchestra-stop.js",
        "loop_limit": 5
      },
      {
        "command": "node ./hooks/orchestra-heartbeat.js",
        "loop_limit": 5
      }
    ]
  }
}
