{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/x-preview-f-free",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**",
      "coverage/**"
    ]
  },
  "snapshot": false,
  "permission": {
    "*": "allow",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/credentials.json": "deny"
    },
    "bash": {
      "*": "allow",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "rm -rf / *": "deny",
      "rm -rf ~ *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.cursor/hooks/**": "allow",
      "~/.cursor/skills/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/Learning Web Development/**": "allow",
      "~/Projects/**": "allow",
      "~/Developer/**": "allow",
      "~/code/**": "allow"
    },
    "skill": {
      "orchestra-loop": "allow",
      "verification-before-completion": "allow",
      "prompt-intake": "allow",
      "greenfield-product": "allow",
      "ui-ux-pro-max": "allow",
      "brand": "allow",
      "design-system": "allow",
      "ui-styling": "allow",
      "internal-*": "deny"
    },
    "websearch": "allow",
    "webfetch": "allow",
    "task": "allow"
  },
  "agent": {
    "orchestra-planner": {
      "model": "opencode/x-preview-f-free",
      "steps": 8,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "deny",
        "webfetch": "deny"
      }
    },
    "orchestra-implementer": {
      "model": "opencode/x-preview-f-free",
      "steps": 25,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "websearch": "deny",
        "webfetch": "deny"
      }
    },
    "orchestra-verifier": {
      "model": "opencode/nemotron-3.5-lightning-free",
      "steps": 10,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "deny"
      }
    },
    "orchestra-reviewer": {
      "model": "opencode/x-preview-f-free",
      "steps": 5,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "deny",
        "webfetch": "deny"
      }
    }
  },
  "provider": {
    "opencode": {
      "models": {
        "x-preview-f-free": {
          "variants": {
            "fast": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            },
            "thorough": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    }
  }
}
