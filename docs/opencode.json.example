{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/big-pickle",
  "default_agent": "orchestra",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 6000,
    "tail_turns": 12
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 12288
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**",
      "coverage/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/.turbo/**",
      "**/.vercel/**",
      "**/vendor/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**"
    ]
  },
  "snapshot": false,
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    "context/project-overview.md",
    "context/architecture.md",
    "context/code-standards.md",
    "context/progress-tracker.md"
  ],
  "permission": {
    "*": "allow",
    "doom_loop": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/credentials.json": "deny"
    },
    "bash": {
      "*": "allow",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "rm -rf / *": "deny",
      "rm -rf ~ *": "deny",
      "git clean -fdx *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "sudo rm -rf *": "deny",
      "mkfs.*": "deny",
      "dd if=* of=/dev/*": "deny",
      "shred *": "deny",
      ":(){ :|:& };:": "deny"
    },
    "external_directory": {
      "*": "allow",
      "~/.cursor/hooks/**": "allow",
      "~/.cursor/skills/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/Learning Web Development/**": "allow",
      "~/Projects/**": "allow",
      "~/Developer/**": "allow",
      "~/code/**": "allow"
    },
    "skill": {
      "*": "deny",
      "orchestra-loop": "allow",
      "verification-before-completion": "allow",
      "prompt-intake": "allow",
      "greenfield-product": "allow",
      "internal-*": "deny"
    },
    "websearch": "allow",
    "webfetch": "allow",
    "task": "allow"
  },
  "agent": {
    "orchestra": {
      "description": "Orchestra conductor \u2014 plan \u2192 implement \u2192 verify \u2192 review via task tool",
      "mode": "primary",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 500,
      "permission": {
        "task": {
          "*": "deny",
          "orchestra-*": "allow",
          "agent-selector*": "allow",
          "project-type-classifier*": "allow",
          "workflow-orchestrator*": "allow",
          "product-owner*": "allow",
          "product-manager*": "allow",
          "project-manager*": "allow",
          "scrum-master*": "allow",
          "stakeholder-advocate*": "allow",
          "business-strategist*": "allow",
          "business-analyst*": "allow",
          "architect*": "allow",
          "tech-lead*": "allow",
          "adr-archivist*": "allow",
          "ui-ux-designer*": "allow",
          "backend-engineer*": "allow",
          "frontend-engineer*": "allow",
          "mobile-engineer*": "allow",
          "full-stack-engineer*": "allow",
          "database-engineer*": "allow",
          "ml-engineer*": "allow",
          "data-engineer*": "allow",
          "devops-engineer*": "allow",
          "platform-engineer*": "allow",
          "qa-engineer*": "allow",
          "automation-engineer*": "allow",
          "regression-tester*": "allow",
          "api-contract-validator*": "allow",
          "accessibility-reviewer*": "allow",
          "performance-engineer*": "allow",
          "model-evaluator*": "allow",
          "code-reviewer*": "allow",
          "technical-debt-tracker*": "allow",
          "compliance-officer*": "allow",
          "legal-advisor*": "allow",
          "security-executive-advisor*": "allow",
          "release-manager*": "allow",
          "ops-manager*": "allow",
          "documentation-writer*": "allow",
          "sre*": "allow",
          "observer*": "allow",
          "incident-responder*": "allow",
          "security-performance-reviewer*": "allow"
        },
        "bash": "allow",
        "edit": "deny",
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "orchestra-planner": {
      "description": "Internal orchestra phase 1 \u2014 plan only",
      "mode": "subagent",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 500,
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "task": "deny"
      }
    },
    "orchestra-implementer": {
      "description": "Internal orchestra phase 2 \u2014 implement",
      "mode": "subagent",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 500,
      "hidden": true,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "task": "deny"
      }
    },
    "orchestra-verifier": {
      "description": "Internal orchestra phase 3 \u2014 verify",
      "mode": "subagent",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 500,
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "task": "deny"
      }
    },
    "orchestra-reviewer": {
      "description": "Internal orchestra phase 4 \u2014 review",
      "mode": "subagent",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 500,
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "task": "deny"
      }
    }
  },
  "provider": {
    "opencode": {
      "models": {
        "big-pickle": {
          "variants": {
            "fast": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            },
            "quality": {
              "reasoningEffort": "medium",
              "textVerbosity": "medium"
            }
          }
        }
      }
    }
  }
}
