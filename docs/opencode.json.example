{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.2-contributor-free",
  "small_model": "opencode/mimo-v2.5-free",
  "default_agent": "orchestra",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 6000,
    "tail_turns": 12
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 12288
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**",
      "coverage/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/.turbo/**",
      "**/.vercel/**",
      "**/vendor/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**"
    ]
  },
  "snapshot": false,
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    "context/project-overview.md",
    "context/architecture.md",
    "context/code-standards.md",
    "context/progress-tracker.md"
  ],
  "permission": {
    "*": "allow",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/credentials.json": "deny"
    },
    "bash": {
      "*": "allow",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "rm -rf / *": "deny",
      "rm -rf ~ *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.cursor/hooks/**": "allow",
      "~/.cursor/skills/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/Learning Web Development/**": "allow",
      "~/Projects/**": "allow",
      "~/Developer/**": "allow",
      "~/code/**": "allow"
    },
    "skill": {
      "*": "deny",
      "orchestra-loop": "allow",
      "verification-before-completion": "allow",
      "prompt-intake": "allow",
      "greenfield-product": "allow",
      "internal-*": "deny"
    },
    "websearch": "allow",
    "webfetch": "allow",
    "task": "allow"
  },
  "agent": {
    "orchestra": {
      "description": "Orchestra conductor — plan → implement → verify → review via task tool",
      "mode": "primary",
      "model": "opencode/muse-spark-1.2-contributor-free",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 40,
      "permission": {
        "task": {
          "*": "deny",
          "orchestra-*": "allow"
        },
        "bash": "allow",
        "edit": "deny",
        "websearch": "allow",
        "webfetch": "allow"
      }
    },
    "orchestra-planner": {
      "description": "Internal orchestra phase 1 — plan only",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.2-contributor-free",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 8,
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "task": "deny"
      }
    },
    "orchestra-implementer": {
      "description": "Internal orchestra phase 2 — implement",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.2-contributor-free",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 25,
      "hidden": true,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "websearch": "deny",
        "webfetch": "allow",
        "task": "deny"
      }
    },
    "orchestra-verifier": {
      "description": "Internal orchestra phase 3 — verify",
      "mode": "subagent",
      "model": "opencode/mimo-v2.5-free",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 10,
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "deny",
        "webfetch": "deny",
        "task": "deny"
      }
    },
    "orchestra-reviewer": {
      "description": "Internal orchestra phase 4 — review",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.2-contributor-free",
      "reasoningEffort": "low",
      "textVerbosity": "low",
      "steps": 5,
      "hidden": true,
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "task": "deny"
      }
    }
  },
  "provider": {
    "opencode": {
      "models": {
        "x-preview-f-free": {
          "variants": {
            "fast": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            },
            "thorough": {
              "reasoningEffort": "high"
            }
          }
        },
        "x-preview-f-free (ox-alpha)": {
          "variants": {
            "fast": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            }
          }
        }
      }
    }
  }
}
